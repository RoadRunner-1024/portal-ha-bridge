<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←  Back"
                android:backgroundTint="#37474F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Portal HA Bridge"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/onSurface"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:fontFamily="monospace"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Shown only while something still needs granting; the detail lives in
             System & Updates, this is just the shortcut when it matters. -->
        <Button
            android:id="@+id/btn_fix_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠  Fix Missing Permissions"
            android:backgroundTint="#E65100"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <!-- ── Settings sections ───────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_camera_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_display_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Display &amp; Presence"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_voice_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voice &amp; Assistants"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_intercom_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intercom"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_sensor_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensors"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_system_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="System &amp; Updates"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="24dp" />

        <!-- ── Connection ──────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONNECTION"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MQTT Broker"
            android:textSize="14sp"
            android:textColor="@color/colorAccent"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/et_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="Host (e.g. 192.168.1.10)"
                android:inputType="textUri"
                android:textColor="@color/onSurface"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/et_port"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Port"
                android:inputType="number"
                android:textColor="@color/onSurface" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username (optional)"
            android:inputType="text"
            android:textColor="@color/onSurface"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password (optional)"
            android:inputType="textPassword"
            android:textColor="@color/onSurface"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device"
            android:textSize="14sp"
            android:textColor="@color/colorAccent"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device name shown in Home Assistant"
            android:inputType="text"
            android:textColor="@color/onSurface"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home Assistant"
            android:textSize="14sp"
            android:textColor="@color/colorAccent"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_ha_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="HA URL (e.g. http://192.168.1.10:8123)"
            android:inputType="textUri"
            android:textColor="@color/onSurface"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_ha_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="HA long-lived token (optional - for voice-assistant control)"
            android:inputType="textPassword"
            android:textColor="@color/onSurface"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save &amp; Restart Service"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="16dp" />
    </LinearLayout>
</ScrollView>
