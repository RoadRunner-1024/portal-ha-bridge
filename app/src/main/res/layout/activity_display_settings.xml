<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←  Back"
                android:backgroundTint="#37474F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display &amp; Presence"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/onSurface"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- ── Presence ────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRESENCE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/sw_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Portal Presence Detection"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uses Portal's own person detection (no app camera needed) and adds a 'Portal Presence' occupancy sensor to Home Assistant. Requires a one-time adb permission."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_presence_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/hint"
            android:background="@color/surface"
            android:padding="10dp"
            android:layout_marginBottom="16dp" />

        <!-- Enhanced presence (also ambient sound) -->
        <Switch
            android:id="@+id/sw_enhanced_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enhanced presence (also use sound)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:id="@+id/tv_enhanced_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Also marks the room occupied when ambient sound rises above the threshold — helps in low light where the camera misses people. Needs Presence Detection on."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/row_presence_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_presence_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sound threshold"
                android:textSize="13sp"
                android:textColor="@color/onSurface" />

            <SeekBar
                android:id="@+id/seek_presence_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40" />
        </LinearLayout>

        <!-- ── Screen ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCREEN"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/sw_screen_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen Off Timer"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turns the screen off after the idle time below. Presence (if enabled) keeps it awake — the countdown starts when the room empties. Off = screen stays on indefinitely."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/row_timeout_mins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turn screen off after"
                android:textSize="14sp"
                android:textColor="@color/onSurface" />

            <EditText
                android:id="@+id/et_timeout_minutes"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:gravity="center"
                android:textColor="@color/onSurface"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="minutes"
                android:textSize="14sp"
                android:textColor="@color/onSurface" />
        </LinearLayout>

        <Switch
            android:id="@+id/sw_claim_dream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blank screen while asleep"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Portal starts its own screensaver whenever the screen times out, so you see a flash of the launcher's screensaver every time it wakes. This replaces it with a blank screen. Turn it off if you would rather use the launcher's screensaver — whatever was set before is put back."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="20dp" />

        <Switch
            android:id="@+id/sw_sleep_ignore_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sleep even if someone's there"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Normally presence keeps the screen awake. Turn this on and the screen-off timer runs anyway, so the Portal goes dark on schedule even with someone in the room. Presence detection itself keeps working."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHOTO SCREENSAVER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/sw_screensaver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photo screensaver"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shows photos over the dashboard when nothing has been touched for a while. Tap the left or right third to move between photos; tap the middle to go back to the dashboard. The camera keeps streaming behind the photos."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/et_screensaver_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.0.10:8355"
            android:inputType="textUri"
            android:textColor="@color/onSurface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Address of your ImmichFrame or Immich Kiosk page. Which photos appear is configured there, not here."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start photos after"
                android:textSize="14sp"
                android:textColor="@color/onSurface" />

            <EditText
                android:id="@+id/et_screensaver_idle"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:gravity="center"
                android:textColor="@color/onSurface"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="seconds idle"
                android:textSize="14sp"
                android:textColor="@color/onSurface" />
        </LinearLayout>

        <Switch
            android:id="@+id/sw_screensaver_on_wake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wake to photos"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When the screen wakes, show the photos instead of the dashboard. Tap the middle of the screen to get to the dashboard."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/sw_screensaver_prestage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep photos ready while asleep"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loads the photo page behind the dark screen so it appears instantly, instead of showing a blank page while it starts up. Uses memory the whole time the Portal is asleep — leave it off if the Portal feels short of memory."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/sw_screensaver_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only when someone's there"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photos only appear while presence is detected, so an empty room goes to the screen-off timer instead of showing a slideshow to nobody. Needs presence detection on."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wake words, Alexa and voice announce now live in Settings → Voice &amp; Assistants. Temperature calibration moved to Settings → Sensors."
            android:textSize="12sp"
            android:textColor="@color/onSurface"
            android:alpha="0.5" />

        <!-- The screen is long enough that the Back button at the top scrolls out of reach. -->
        <Button
            android:id="@+id/btn_back_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
