<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←  Back"
                android:backgroundTint="#37474F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display &amp; Presence"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/onSurface"
                android:layout_marginStart="16dp" />
        </LinearLayout>

        <!-- ── Presence ────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRESENCE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/sw_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Portal Presence Detection"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uses Portal's own person detection (no app camera needed) and adds a 'Portal Presence' occupancy sensor to Home Assistant. Requires a one-time adb permission."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_presence_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/hint"
            android:background="@color/surface"
            android:padding="10dp"
            android:layout_marginBottom="16dp" />

        <!-- Enhanced presence (also ambient sound) -->
        <Switch
            android:id="@+id/sw_enhanced_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enhanced presence (also use sound)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:id="@+id/tv_enhanced_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Also marks the room occupied when ambient sound rises above the threshold — helps in low light where the camera misses people. Needs Presence Detection on."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/row_presence_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tv_presence_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sound threshold"
                android:textSize="13sp"
                android:textColor="@color/onSurface" />

            <SeekBar
                android:id="@+id/seek_presence_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40" />
        </LinearLayout>

        <!-- ── Screen ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCREEN"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/sw_screen_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen Off Timer"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turns the screen off after the idle time below. Presence (if enabled) keeps it awake — the countdown starts when the room empties. Off = screen stays on indefinitely."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/row_timeout_mins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turn screen off after"
                android:textSize="14sp"
                android:textColor="@color/onSurface" />

            <EditText
                android:id="@+id/et_timeout_minutes"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:gravity="center"
                android:textColor="@color/onSurface"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="minutes"
                android:textSize="14sp"
                android:textColor="@color/onSurface" />
        </LinearLayout>

        <Switch
            android:id="@+id/sw_shorten_os_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shorten the Portal's own screen timeout"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sets the Portal's ambient display timeout to 1 minute (it ships at 5). This has no effect while the dashboard is on screen — it only shortens how long the launcher can sit there after a restart or if something else takes over. Turning this off puts your original value back."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="20dp" />

        <Switch
            android:id="@+id/sw_start_on_boot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show dashboard after a restart"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="After a reboot or a power cut, put the dashboard back on screen instead of leaving the Portal on the launcher. The bridge itself always starts on boot either way — this only decides what you see."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="20dp" />

        <Switch
            android:id="@+id/sw_claim_dream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blank screen while asleep"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Portal starts its own screensaver whenever the screen times out, so you see a flash of the launcher's screensaver every time it wakes. This replaces it with a blank screen. Turn it off if you would rather use the launcher's screensaver — whatever was set before is put back."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="20dp" />

        <Switch
            android:id="@+id/sw_sleep_ignore_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sleep even if someone's there"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            android:paddingVertical="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Normally presence keeps the screen awake. Turn this on and the screen-off timer runs anyway, so the Portal goes dark on schedule even with someone in the room. Presence detection itself keeps working."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PHOTO SCREENSAVER"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_screensaver_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Photo Screensaver settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show your photos over the dashboard when the Portal has been left alone. Set the address, timings and wake behaviour there."
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wake words, Alexa and voice announce now live in Settings → Voice &amp; Assistants. Temperature calibration moved to Settings → Sensors."
            android:textSize="12sp"
            android:textColor="@color/onSurface"
            android:alpha="0.5" />

        <!-- The screen is long enough that the Back button at the top scrolls out of reach. -->
        <Button
            android:id="@+id/btn_back_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
