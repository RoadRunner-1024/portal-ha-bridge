<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard menu, opened over another app by the left-edge swipe (EdgeMenuOverlay). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dimmed backdrop: tapping it closes the menu and leaves you in the app behind. -->
    <View
        android:id="@+id/menu_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <ScrollView
        android:id="@+id/menu_panel"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1A1A2E"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Portal HA Bridge"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btn_menu_dashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back to HA Bridge"
                android:backgroundTint="#3949AB"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_menu_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Home"
                android:backgroundTint="#3A3A5C" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apps"
                android:textColor="#AAB0FF"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:id="@+id/grid_menu_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
